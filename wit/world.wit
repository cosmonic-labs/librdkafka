package cosmonic:kafka@0.3.0;

/// A workload that produces.
@since(version = 0.1.0)
world producer-client {
    @since(version = 0.1.0)
    import types;
    @since(version = 0.1.0)
    import producer;
}

/// A long-lived consumer **service**.
///
/// Consuming is a service, not a component. A wasmCloud component is
/// instantiated per request and torn down after it, which leaves nowhere to
/// hold a record stream, and — more importantly — nothing to drive the group
/// heartbeat between requests. A consumer that stops reading is a consumer the
/// group evicts.
///
/// A service instead exports `wasi:cli/run`, which the host calls once at
/// startup and expects to block indefinitely. That single long-lived call is
/// what owns the `stream<consumed-record>` and keeps the membership alive.
///
/// The shape of `run` is a loop over the stream:
///
/// ```text
/// let consumer = consumer::open(config).await?;
/// consumer.subscribe(topics).await?;
/// let (records, done) = consumer.records();
/// loop {
///     select {
///         rec = records.next() => { process(rec); consumer.commit(..).await?; }
///         ev  = rebalances.next() => { /* commit before revoke */ }
///     }
/// }
/// ```
///
/// Handle `rebalances` in the same loop. Records and assignment changes arrive
/// on separate streams, and committing an offset for a partition that has
/// already been revoked is where duplicate processing starts.
@since(version = 0.1.0)
world consumer-service {
    @since(version = 0.1.0)
    import types;
    @since(version = 0.1.0)
    import consumer;

    /// Called once at startup; blocks for the life of the service.
    @since(version = 0.1.0)
    export wasi:cli/run@0.3.0;
}

/// A long-lived read-process-write **service**.
///
/// Consumes, transforms, and produces from the one instance. Combined with
/// `transaction.send-offsets`, this is the exactly-once pattern: the offsets
/// consumed and the records produced commit atomically, so a crash mid-batch
/// replays cleanly instead of double-writing.
@since(version = 0.1.0)
world processor-service {
    @since(version = 0.1.0)
    import types;
    @since(version = 0.1.0)
    import consumer;
    @since(version = 0.1.0)
    import producer;

    @since(version = 0.1.0)
    export wasi:cli/run@0.3.0;
}

/// The Kafka capability implemented as a wasmCloud host component plugin.
///
/// One long-lived, host-scoped instance serves every workload that binds to it.
/// That split is the point: a Kafka client is stateful — connections to every
/// broker, cached metadata, partition leadership, group membership with
/// heartbeats — and none of it survives a per-request component instance.
///
/// ## Per-workload clients
///
/// The plugin does not hold one shared Kafka client. Kafka authorises per
/// principal (ACLs on topics and groups), so a shared client would give every
/// workload identical rights and defeat the isolation the sandbox exists to
/// provide. Instead `on-workload-bind` delivers each workload's own
/// `bootstrap.servers`, credentials and topic set, and the plugin opens a
/// client per workload, keyed by workload id.
///
/// Later capability calls carry no binding information, so the plugin
/// correlates them back with `wasmcloud:host/identity.get-workload-id()`. That
/// identity is the only thing distinguishing one tenant's calls from another's,
/// which makes the `identity` import mandatory rather than a convenience.
///
/// ## Credentials
///
/// A workload declares them on its interface binding, and the host merges
/// `config` -> `configFrom` -> `secretFrom` (last wins) before delivering the
/// result as this binding's config:
///
/// ```yaml
/// hostInterfaces:
///   - namespace: cosmonic
///     package: kafka
///     version: "0.3.0"
///     interfaces: [producer, consumer]
///     config:
///       bootstrap.servers: kafka.svc:9092
///       group.id: orders-processor
///       topics: orders,payments        # what this workload may consume
///     secretFrom:
///       - kafka-credentials            # sasl.username, sasl.password, ...
/// ```
///
/// Every key is passed to librdkafka verbatim, so any auth mechanism it
/// supports works unchanged: SASL/PLAIN, SCRAM-SHA-256/512, OAUTHBEARER,
/// GSSAPI, or mTLS via `ssl.key.pem` / `ssl.certificate.pem`.
///
/// The plugin should treat `topics` as the whole permission grant for the calls
/// a guest makes: `producer.send`, `consumer.subscribe`, and anything else that
/// names a topic. A workload that did not declare a topic should not be able to
/// reach it, even though the broker-side ACL is the real enforcement point.
///
/// `group.id` here is an ordinary librdkafka property, passed through for the
/// consumer a guest opens itself. Handlers use their own key, below.
///
/// ## Two shapes of delivery
///
/// **Pull.** A workload holds a `consumer` resource and reads `records()`. The
/// call is ingress, so the stream carries records outward without the provider
/// calling in — and the consuming workload must be long-lived to hold it.
///
/// **Push.** The provider calls `handler.handle` on a workload that exports it,
/// which frees the workload from being long-lived: it is started for a batch and
/// retires when the burst drains. This was not possible when this package was
/// first written — a component plugin's imports resolve against the host's own
/// plugins, never against workloads — and `wasmcloud:host/workload-call` is what
/// changed it. A plugin opens a target for a workload id and an interface and
/// calls it. Both shapes are optional: a provider may serve either, and a
/// consuming workload picks by importing `consumer` or exporting `handler`.
///
/// ### Configuring a handler
///
/// A handler never calls `open`, so everything it needs comes from the same
/// interface config that bounds a guest's own calls. The two want different
/// answers, so the push path has its own keys:
///
/// ```yaml
/// hostInterfaces:
///   - namespace: cosmonic
///     package: kafka
///     version: "0.3.0"
///     interfaces: [handler]
///     config:
///       bootstrap.servers: kafka.svc:9092
///       handler.topics: orders             # dispatched from
///       handler.group.id: orders-processor # the group this handler joins
///       dead-letter.topic: orders.dlq      # where `permanent` goes
///       topics: orders,orders.enriched     # what its own sends may reach
/// ```
///
/// `handler.topics` is the subscription and nothing else. It cannot be
/// `topics`, because a handler that reads one topic and writes another has to
/// be dispatched from the first and allowed to produce to the second. Put the
/// output in one shared key and the handler subscribes to its own output; leave
/// it out and the send is denied.
///
/// `handler.group.id` is the group the provider's consumer joins. It needs its
/// own key because this config is also merged over a guest's `open` arguments
/// with the host winning, so a plain `group.id` would move every consumer the
/// guest opens into the handler's group.
///
/// `dead-letter.topic` is where a `permanent` batch goes, and a provider should
/// require it. Past whatever redelivery bound it applies there is nowhere else
/// for the batch, leaving a stalled partition or a dropped record.
///
/// Refuse a handler binding missing any of the three at bind, not at first
/// dispatch. Otherwise it is a handler that never runs, which looks the same as
/// a topic with no traffic.
///
@since(version = 0.1.0)
world host-plugin {
    /// The capability itself, served across store boundaries to bound
    /// workloads.
    @since(version = 0.1.0)
    export types;
    @since(version = 0.1.0)
    export producer;
    @since(version = 0.1.0)
    export consumer;

    /// Per-workload provisioning. `on-workload-bind` receives the interface
    /// config above and is where this plugin opens that workload's client;
    /// returning an error there fails the workload's deployment, which is the
    /// desired behaviour for bad credentials — fail at deploy, not at first
    /// send.
    @since(version = 0.1.0)
    export wasmcloud:host/workload-lifecycle@0.1.3;

    /// Which workload is calling. Required: capability calls carry no binding
    /// identity, so this is the only way to select that tenant's client.
    @since(version = 0.1.0)
    import wasmcloud:host/identity@0.1.3;

    /// Cooperative cancellation, so a long fetch can be unwound instead of
    /// occupying the plugin instance.
    @since(version = 0.1.0)
    import wasmcloud:host/cancel@0.1.3;

    /// The push path, and it is optional: a provider that only serves `consumer`
    /// never opens a target. `handler` is *imported* here because the workload
    /// is the one that exports it — a plugin calls in, rather than being called.
    @since(version = 0.2.0)
    import handler;
    @since(version = 0.2.0)
    import wasmcloud:host/workload-call@0.1.3;
}

/// A workload that is *given* records rather than reading them.
///
/// The push counterpart to `consumer-service`, and the reason it exists: this
/// component holds no consumer, no stream, and no group membership, so it can be
/// per-request. It is started when there is a batch and retires when there is
/// not, which is what makes a bursty topic scale to the work and back down.
@since(version = 0.2.0)
world record-handler {
    @since(version = 0.2.0)
    import types;

    /// Handling a batch usually means producing something. Importing `producer`
    /// here rather than defining a second world is deliberate: the read side is
    /// the export, so this stays one world with both directions.
    @since(version = 0.2.0)
    import producer;

    @since(version = 0.2.0)
    export handler;
}
